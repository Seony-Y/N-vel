# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요

# Neon > 프로젝트 > Connect 에서 복사 (postgresql://... 형식)
DATABASE_URL=

# 로그인 (Better Auth)
# 비밀키: 아무 긴 랜덤 문자열. 생성 예) npx @better-auth/cli secret  또는  openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# https://console.anthropic.com
ANTHROPIC_API_KEY=

# 모델 설정 (비워두면 기본값 사용)
# CHAT_MODEL=claude-haiku-5-5     # 새 플레이의 기본 모델 (사용자가 시작할 때 바꿀 수 있음)

# 테스트 응답 모드: true 이면 Claude API 를 호출하지 않고 "테스트 응답입니다" 를 보냄 (비용 0)
MOCK_AI=true

# 메일 발송 (Resend, https://resend.com). 비워두면 메일을 보내지 않고 서버 콘솔에 인증 링크를 찍는다
RESEND_API_KEY=
# 보내는 주소. Resend 에서 인증한 도메인이어야 한다 (인증 전에는 onboarding@resend.dev, 내 Resend 가입 메일로만 발송 가능)
EMAIL_FROM=N-vel <onboarding@resend.dev>
